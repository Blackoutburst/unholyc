#include <stdio.h>
#include <stdlib.h>
#include <uhcio.uhh>

I32 main() {
    const I8* path = "examples/08_file_io.uhc"

    File f = File.open(path)
    if (f.handle == NULL) {
        Log.error("failed to open: %s", path)
        return 1
    }

    Log.info("opened '%s' (%lld bytes)", path, f.size)

    I8* contents = File.read(f)
    if (contents != NULL) {
        Log.msg("--- first 80 chars ---")
        I8 preview[81]
        I32 len = (I32)f.size < 80 ? (I32)f.size : 80
        for (I32 i = 0; i < len; i++) {
            preview[i] = contents[i]
        }
        preview[len] = '\0'
        Log.msg("%s", preview)
        free(contents)
    }

    File.close(f)
    Log.info("done")

    return 0
}
