#include <stdio.h>
#include <stdlib.h>
#include <uhcio.uhh>

I32 main() {
    String path = "examples/08_file_io.uhc"

    File f = File.open(path)
    if (f.handle == NULL) {
        Log.error("failed to open: %T", path)
        return 1
    }

    Log.info("opened '%T' (%lld bytes)", path, f.size)

    String contents = File.read(f)
    if (!String.isEmpty(contents)) {
        Log.msg("--- first 80 chars ---")
        I32 len = (I32)f.size < 80 ? (I32)f.size : 80
        String preview = String.substring(contents, 0, len)
        Log.msg("%T", preview)
    }

    File.close(f)
    Log.info("done")

    return 0
}
