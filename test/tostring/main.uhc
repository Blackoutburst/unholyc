#include <uhcio.uhh>
#include <uhcmath.uhh>

namespace Color {
    self {
        U8 r = 0
        U8 g = 0
        U8 b = 0
    }

    const I8* toString(Color c) {
        return "rgb(%d, %d, %d)", c.r, c.g, c.b
    }
}

I32 main() {

    Color c = {255, 128, 0}
    Log.info("Manual: %T", c)

    VectorF v = { 1.0f, 2.0f, 3.0f, 4.0f }
    Log.debug("Auto: %T", v)
    return 0
}
