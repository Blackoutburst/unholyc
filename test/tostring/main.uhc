#include <uhcio.uhh>
#include <uhcmath.uhh>
#include <uhcstd.uhh>
#include <lambda.uhh>

namespace Color {
    self {
        U8 r = 0
        U8 g = 0
        U8 b = 0
    }

    const I8* toString(Color c) {
        return "rgb(%d, %d, %d)", c.r, c.g, c.b
    }
}

I32 main() {

    Color c = {255, 128, 0}
    Log.info("Manual: %T", c)

    VectorF v1 = { 1.0f, 1.0f, 1.0f, 1.0f }
    VectorF v2 = { 2.0f, 2.0f, 2.0f, 2.0f }
    VectorF v3 = { 3.0f, 3.0f, 3.0f, 3.0f }
    VectorF v4 = { 4.0f, 4.0f, 4.0f, 4.0f }

    List<VectorF> vecs
    List.add(vecs, v1)
    List.add(vecs, v2)
    List.add(vecs, v3)
    List.add(vecs, v4)

    forEach(vecs) { (v) ->
        Log.info("Auto: %T", v)
    }
    
    return 0
}
