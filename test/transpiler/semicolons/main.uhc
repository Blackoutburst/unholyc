#include <stdio.h>

// Test: optional semicolons — with, without, and mixed in same file

// All semicolons explicit
I32 withSemis(I32 x) {
    I32 a = x + 1;
    I32 b = a * 2;
    return b;
}

// No semicolons at all
I32 noSemis(I32 x) {
    I32 a = x + 1
    I32 b = a * 2
    return b
}

// Mixed — some lines have semicolons, some don't
I32 mixed(I32 x) {
    I32 a = x + 1;
    I32 b = a * 2
    I32 c = b - 1;
    return c
}

// Semicolons in for-loop init/condition/increment (required by C syntax)
I32 forLoop() {
    I32 sum = 0
    for (I32 i = 0; i < 5; i++) {
        sum += i
    }
    return sum
}

// if/else without semis
I32 branch(I32 x) {
    if (x > 0)
        return 1
    else if (x < 0)
        return -1
    else
        return 0
}

// Semicolon after closing brace (should be harmless no-op)
I32 afterBrace() {
    I32 x = 10;
    return x;
}

I32 main() {
    if (withSemis(3) != 8) { printf("FAIL: withSemis\n"); return 1; }
    if (noSemis(3) != 8) { printf("FAIL: noSemis\n"); return 1; }
    if (mixed(3) != 7) { printf("FAIL: mixed\n"); return 1; }
    if (forLoop() != 10) { printf("FAIL: forLoop\n"); return 1; }
    if (branch(5) != 1) { printf("FAIL: branch pos\n"); return 1; }
    if (branch(-3) != -1) { printf("FAIL: branch neg\n"); return 1; }
    if (branch(0) != 0) { printf("FAIL: branch zero\n"); return 1; }
    if (afterBrace() != 10) { printf("FAIL: afterBrace\n"); return 1; }

    printf("semicolons: all tests passed\n")
    return 0
}
