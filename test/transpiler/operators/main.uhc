#include <stdio.h>

// Test: operator overloading in self blocks
// Tests ==, +, -, *, unary -

namespace Vec2 {
    self {
        F32 x
        F32 y

        U8 operator==(Vec2 o) {
            return x == o.x && y == o.y
        }

        Vec2 operator+(Vec2 o) {
            Vec2 r
            r.x = x + o.x
            r.y = y + o.y
            return r
        }

        Vec2 operator-(Vec2 o) {
            Vec2 r
            r.x = x - o.x
            r.y = y - o.y
            return r
        }

        Vec2 operator*(F32 s) {
            Vec2 r
            r.x = x * s
            r.y = y * s
            return r
        }

        Vec2 operator-() {
            Vec2 r
            r.x = -x
            r.y = -y
            return r
        }
    }

    Vec2 create(F32 x, F32 y) {
        Vec2 v
        v.x = x
        v.y = y
        return v
    }
}

I32 main() {
    Vec2 a = Vec2.create(1.0f, 2.0f)
    Vec2 b = Vec2.create(3.0f, 4.0f)

    // ==
    Vec2 a2 = Vec2.create(1.0f, 2.0f)
    if (!(a == a2)) {
        printf("FAIL: operator== equal\n")
        return 1
    }
    if (a == b) {
        printf("FAIL: operator== not-equal\n")
        return 1
    }

    // +
    Vec2 sum = a + b
    if (sum.x != 4.0f || sum.y != 6.0f) {
        printf("FAIL: operator+ got %f %f\n", sum.x, sum.y)
        return 1
    }

    // -
    Vec2 diff = b - a
    if (diff.x != 2.0f || diff.y != 2.0f) {
        printf("FAIL: operator- got %f %f\n", diff.x, diff.y)
        return 1
    }

    // *
    Vec2 scaled = a * 3.0f
    if (scaled.x != 3.0f || scaled.y != 6.0f) {
        printf("FAIL: operator* got %f %f\n", scaled.x, scaled.y)
        return 1
    }

    // unary -
    Vec2 neg = -a
    if (neg.x != -1.0f || neg.y != -2.0f) {
        printf("FAIL: unary operator- got %f %f\n", neg.x, neg.y)
        return 1
    }

    // chained
    Vec2 chained = (a + b) * 2.0f
    if (chained.x != 8.0f || chained.y != 12.0f) {
        printf("FAIL: chained (a+b)*2 got %f %f\n", chained.x, chained.y)
        return 1
    }

    // operator== on result
    Vec2 expected = Vec2.create(8.0f, 12.0f)
    if (!(chained == expected)) {
        printf("FAIL: chained == expected\n")
        return 1
    }

    printf("operators: all tests passed\n")
    return 0
}
