#pragma once

#if defined(_WIN32) || defined(_WIN64)
    #include <winsock2.h>
    #include <windows.h>
#else
    #include <unistd.h>
    #include <pthread.h>
    #include <dlfcn.h>
    #include <time.h>
#endif

#include <list>
#include <string>
#include <algorithm>

/// Mutual exclusion primitive for thread synchronization
namespace Mutex {
    /// Platform-specific mutex handle
#if defined(_WIN32) || defined(_WIN64)
    self {
        CRITICAL_SECTION handle
    }
#else
    self {
        pthread_mutex_t handle
    }
#endif

    /// Create and initialize a new mutex
    /// @returns Initialized mutex object
    Mutex create()
    /// Destroy a mutex and release its resources
    /// @param mutex The mutex to destroy
    U0 destroy(Mutex mutex)
    /// Acquire a mutex, blocking until it is available
    /// @param mutex The mutex to lock
    U0 lock(Mutex mutex)
    /// Release a previously acquired mutex
    /// @param mutex The mutex to unlock
    U0 unlock(Mutex mutex)
}

/// Little-endian byte order constant
#define UHC_LITTLE_ENDIAN 0
/// Big-endian byte order constant
#define UHC_BIG_ENDIAN 1

/// Binary buffer with cursor-based reading and writing
namespace Buffer {
    /// Buffer object
    self {
        U0* handle
        U8 order
        U32 cursor
    }

    /// Set the byte order for subsequent get/put operations
    /// @param buffer The buffer
    /// @param order Byte order — use UHC_LITTLE_ENDIAN or UHC_BIG_ENDIAN
    U0 setOrder(Buffer buffer, U8 order)
    /// Reset the buffer cursor to the beginning
    /// @param buffer The buffer
    U0 reset(Buffer buffer)
    /// Read a signed 8-bit integer from the buffer
    /// @param buffer The buffer
    /// @returns The value read
    I8 getI8(Buffer buffer)
    /// Read an unsigned 8-bit integer from the buffer
    /// @param buffer The buffer
    /// @returns The value read
    U8 getU8(Buffer buffer)
    /// Read a signed 16-bit integer from the buffer
    /// @param buffer The buffer
    /// @returns The value read
    I16 getI16(Buffer buffer)
    /// Read an unsigned 16-bit integer from the buffer
    /// @param buffer The buffer
    /// @returns The value read
    U16 getU16(Buffer buffer)
    /// Read a signed 32-bit integer from the buffer
    /// @param buffer The buffer
    /// @returns The value read
    I32 getI32(Buffer buffer)
    /// Read an unsigned 32-bit integer from the buffer
    /// @param buffer The buffer
    /// @returns The value read
    U32 getU32(Buffer buffer)
    /// Read a signed 64-bit integer from the buffer
    /// @param buffer The buffer
    /// @returns The value read
    I64 getI64(Buffer buffer)
    /// Read an unsigned 64-bit integer from the buffer
    /// @param buffer The buffer
    /// @returns The value read
    U64 getU64(Buffer buffer)
    /// Read a 32-bit float from the buffer
    /// @param buffer The buffer
    /// @returns The value read
    F32 getF32(Buffer buffer)
    /// Read a 64-bit float from the buffer
    /// @param buffer The buffer
    /// @returns The value read
    F64 getF64(Buffer buffer)
    /// Write a signed 8-bit integer to the buffer
    /// @param buffer The buffer
    /// @param value The value to write
    U0 putI8(Buffer buffer, I8 value)
    /// Write an unsigned 8-bit integer to the buffer
    /// @param buffer The buffer
    /// @param value The value to write
    U0 putU8(Buffer buffer, U8 value)
    /// Write a signed 16-bit integer to the buffer
    /// @param buffer The buffer
    /// @param value The value to write
    U0 putI16(Buffer buffer, I16 value)
    /// Write an unsigned 16-bit integer to the buffer
    /// @param buffer The buffer
    /// @param value The value to write
    U0 putU16(Buffer buffer, U16 value)
    /// Write a signed 32-bit integer to the buffer
    /// @param buffer The buffer
    /// @param value The value to write
    U0 putI32(Buffer buffer, I32 value)
    /// Write an unsigned 32-bit integer to the buffer
    /// @param buffer The buffer
    /// @param value The value to write
    U0 putU32(Buffer buffer, U32 value)
    /// Write a signed 64-bit integer to the buffer
    /// @param buffer The buffer
    /// @param value The value to write
    U0 putI64(Buffer buffer, I64 value)
    /// Write an unsigned 64-bit integer to the buffer
    /// @param buffer The buffer
    /// @param value The value to write
    U0 putU64(Buffer buffer, U64 value)
    /// Write a 32-bit float to the buffer
    /// @param buffer The buffer
    /// @param value The value to write
    U0 putF32(Buffer buffer, F32 value)
    /// Write a 64-bit float to the buffer
    /// @param buffer The buffer
    /// @param value The value to write
    U0 putF64(Buffer buffer, F64 value)
}

/// Lightweight thread creation and joining
namespace Thread {
    /// Thread entry point function type
    typedef U0* (*Fn)(U0*)

    /// Platform-specific thread handle
#if defined(_WIN32) || defined(_WIN64)
    self {
        HANDLE handle
    }
#else
    self {
        pthread_t handle
    }
#endif

    /// Start a new thread running the given function
    /// @param method The thread entry function
    /// @param arg Argument passed to the thread function
    /// @returns Thread handle — use with join
    Thread start(Thread.Fn method, U0* arg)
    /// Wait for a thread to finish
    /// @param thread The thread to wait on
    U0 join(Thread thread)
}

/// Cross-platform shared library loader
namespace DynamicLibrary {
    /// Platform-specific dynamic library handle
#if defined(_WIN32) || defined(_WIN64)
    self {
        HINSTANCE handle
        I8* name
        U8 isValid
    }
#else
    self {
        U0* handle
        I8* name
        U8 isValid
    }
#endif

    /// Load a shared library by name or path
    /// @param name Library name or path
    /// @returns Library object — check isValid before use
    DynamicLibrary load(const I8* name)
    /// Retrieve a function pointer from a loaded library
    /// @param dll The dynamic library
    /// @param functionName The exported symbol name
    /// @returns Raw function pointer — cast before calling
    U0* get(DynamicLibrary dll, const I8* functionName)
    /// Unload a dynamic library and free its resources
    /// @param dll The dynamic library
    U0 unload(DynamicLibrary dll)
}


/// Generic doubly-linked list
namespace List {
    /// List container object
    template<typename T>
    self {
        std::list<T> handle
        It() = default;
        It(std::initializer_list<T> init) : handle(init) {}
        T& operator[](int idx) { auto it = handle.begin(); std::advance(it, idx); return *it; }
    }

    /// Append a value to the end of the list
    /// @param list Target list
    /// @param value Value to append
    template<typename T>
    U0 add(List<T> list, T value) {
        list.handle.push_back(value)
    }

    /// Insert a value at a specific index
    /// @param list Target list
    /// @param value Value to insert
    /// @param index Zero-based position
    template<typename T>
    U0 addAt(List<T> list, T value, I32 index) {
        auto it = list.handle.begin()
        std::advance(it, index)
        list.handle.insert(it, value)
    }

    /// Remove the first matching value from the list
    /// @param list Target list
    /// @param value Value to find and remove
    /// @returns Non-zero if element was found and removed
    template<typename T>
    U8 remove(List<T> list, T value) {
        auto it = std::find(list.handle.begin(), list.handle.end(), value)
        if (it == list.handle.end()) return 0
        list.handle.erase(it)
        return 1
    }

    /// Remove the element at a specific index
    /// @param list Target list
    /// @param index Zero-based position to remove
    template<typename T>
    U0 removeAt(List<T> list, I32 index) {
        auto it = list.handle.begin()
        std::advance(it, index)
        list.handle.erase(it)
    }

    /// Get a reference to the element at a specific index
    /// @param list Target list
    /// @param index Zero-based position
    /// @returns Reference to the element
    template<typename T>
    T& get(List<T> list, I32 index) {
        auto it = list.handle.begin()
        std::advance(it, index)
        return *it
    }

    /// Set the value of an element at a specific index
    /// @param list Target list
    /// @param index Zero-based position
    /// @param value New value
    template<typename T>
    U0 set(List<T> list, I32 index, T value) {
        auto it = list.handle.begin()
        std::advance(it, index)
        *it = value
    }

    /// Get a reference to the first element
    /// @param list Target list
    /// @returns Reference to first element (undefined behavior if empty)
    template<typename T>
    T& first(List<T> list) {
        return list.handle.front()
    }

    /// Get a reference to the last element
    /// @param list Target list
    /// @returns Reference to last element (undefined behavior if empty)
    template<typename T>
    T& last(List<T> list) {
        return list.handle.back()
    }

    /// Get the number of elements in the list
    /// @param list Target list
    /// @returns Element count
    template<typename T>
    U64 size(List<T> list) {
        return (U64)list.handle.size()
    }

    /// Remove all elements from the list
    /// @param list Target list
    template<typename T>
    U0 clear(List<T> list) {
        list.handle.clear()
    }
}

/// UTF-8 string with value semantics and Kotlin-style API
namespace String {
    self {
        std::string handle;
        It() = default;
        It(const I8* s) : handle(s ? s : "") {}
        It(const std::string& s) : handle(s) {}
        It operator+(const It& o) { return It(handle + o.handle); }
        It operator+(const I8* s) { return It(handle + (s ? s : "")); }
        friend It operator+(const I8* s, const It& o) { return It(std::string(s ? s : "") + o.handle); }
        U8 operator==(const It& o) { return handle == o.handle ? 1 : 0; }
        U8 operator!=(const It& o) { return handle != o.handle ? 1 : 0; }
    }

    /// Create a String from a C string literal or pointer — null becomes empty string
    /// @param s Source C string (may be null)
    /// @returns New String value
    String from(const I8* s)
    /// Create a String from a signed 32-bit integer
    /// @param n Integer to convert
    /// @returns Decimal string representation
    String fromI32(I32 n)
    /// Create a String from a signed 64-bit integer
    /// @param n Integer to convert
    /// @returns Decimal string representation
    String fromI64(I64 n)
    /// Create a String from a 32-bit float
    /// @param f Float to convert
    /// @returns Decimal string representation
    String fromF32(F32 f)
    /// Create a String from a 64-bit float
    /// @param f Float to convert
    /// @returns Decimal string representation
    String fromF64(F64 f)
    /// Return the underlying C string pointer — valid only while the String is alive
    /// @param s Source string
    /// @returns Read-only C string pointer
    const I8* c(const String s)
    /// Return the number of bytes in the string (not Unicode code points)
    /// @param s Source string
    /// @returns Byte count
    U64 length(const String s)
    /// Return 1 if the string has zero bytes, 0 otherwise
    /// @param s Source string
    /// @returns 1 if empty, 0 if not
    U8 isEmpty(const String s)
    /// Return the byte at the given index — no bounds checking
    /// @param s Source string
    /// @param i Zero-based byte index
    /// @returns Byte value at that position
    I8 charAt(const String s, I32 i)
    /// Return 1 if both strings have identical content
    /// @param a First string
    /// @param b Second string
    /// @returns 1 if equal, 0 if not
    U8 equals(const String a, const String b)
    /// Return 1 if sub appears anywhere inside s
    /// @param s String to search in
    /// @param sub Substring to find
    /// @returns 1 if found, 0 if not
    U8 contains(const String s, const String sub)
    /// Return 1 if s begins with prefix
    /// @param s String to test
    /// @param prefix Prefix to look for
    /// @returns 1 if s starts with prefix, 0 if not
    U8 startsWith(const String s, const String prefix)
    /// Return 1 if s ends with suffix
    /// @param s String to test
    /// @param suffix Suffix to look for
    /// @returns 1 if s ends with suffix, 0 if not
    U8 endsWith(const String s, const String suffix)
    /// Return the byte offset of the first occurrence of sub, or -1 if not found
    /// @param s String to search in
    /// @param sub Substring to find
    /// @returns Zero-based offset, or -1
    I64 indexOf(const String s, const String sub)
    /// Return the byte offset of the last occurrence of sub, or -1 if not found
    /// @param s String to search in
    /// @param sub Substring to find
    /// @returns Zero-based offset, or -1
    I64 lastIndexOf(const String s, const String sub)
    /// Return a copy of s with all ASCII letters uppercased
    /// @param s Source string
    /// @returns Uppercased string
    String toUpperCase(const String s)
    /// Return a copy of s with all ASCII letters lowercased
    /// @param s Source string
    /// @returns Lowercased string
    String toLowerCase(const String s)
    /// Return a copy of s with leading and trailing ASCII whitespace removed
    /// @param s Source string
    /// @returns Trimmed string
    String trim(const String s)
    /// Return a copy of s with leading ASCII whitespace removed
    /// @param s Source string
    /// @returns Left-trimmed string
    String trimStart(const String s)
    /// Return a copy of s with trailing ASCII whitespace removed
    /// @param s Source string
    /// @returns Right-trimmed string
    String trimEnd(const String s)
    /// Return a copy of s with every occurrence of from replaced by to
    /// @param s Source string
    /// @param from Substring to find
    /// @param to Replacement value
    /// @returns Modified string
    String replace(const String s, const String from, const String to)
    /// Return the substring from start to the end of the string
    /// @param s Source string
    /// @param start Zero-based start index (inclusive)
    /// @returns Substring
    String substring(const String s, I32 start)
    /// Return the substring from start (inclusive) to end (exclusive)
    /// @param s Source string
    /// @param start Zero-based start index (inclusive)
    /// @param end Zero-based end index (exclusive)
    /// @returns Substring
    String substring(const String s, I32 start, I32 end)
    /// Return the string repeated n times
    /// @param s Source string
    /// @param n Number of repetitions
    /// @returns Repeated string
    String repeat(const String s, I32 n)
    /// Return a copy of s with its bytes in reverse order
    /// @param s Source string
    /// @returns Reversed string
    String reverse(const String s)
    /// Parse the string as a signed 32-bit integer — throws on failure
    /// @param s Source string
    /// @returns Parsed integer
    I32 toI32(const String s)
    /// Parse the string as a signed 64-bit integer — throws on failure
    /// @param s Source string
    /// @returns Parsed integer
    I64 toI64(const String s)
    /// Parse the string as a 32-bit float — throws on failure
    /// @param s Source string
    /// @returns Parsed float
    F32 toF32(const String s)
    /// Parse the string as a 64-bit float — throws on failure
    /// @param s Source string
    /// @returns Parsed float
    F64 toF64(const String s)
    /// Build a String using printf-style formatting
    /// @param fmt Format string (same specifiers as printf)
    /// @returns Formatted string (capped at 4096 bytes)
    String format(const I8* fmt, ...)
    /// Split s on every occurrence of delim and return all parts as a list
    /// @param s Source string
    /// @param delim Delimiter to split on
    /// @returns List of substrings (always at least one element)
    List<String> split(const String s, const String delim)
    /// Concatenate all strings in parts, inserting sep between each pair
    /// @param parts List of strings to join
    /// @param sep Separator inserted between elements
    /// @returns Joined string
    String join(List<String> parts, const String sep)
    /// Return the underlying C string pointer — used by %T format specifier
    /// @param s Source string
    /// @returns Read-only C string pointer
    const I8* toString(const String s)
}

/// Cross-platform time utilities
namespace Time {
    /// Sleep for the given number of milliseconds
    /// @param ms Duration in milliseconds
    U0 sleep(U64 ms)
    /// Current value of a monotonic clock in milliseconds.
    /// Subtract two calls to measure elapsed time.
    /// @returns Milliseconds since an arbitrary fixed start point
    U64 millis()
}
