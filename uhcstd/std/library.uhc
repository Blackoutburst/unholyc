#include <stdio.h>
#include <string.h>

#include "uhcio.uhh"
#include "uhcstd.uhh"

namespace DynamicLibrary {

    static const DynamicLibrary invalidLibrary = {NULL, "", 0}

#if defined(_WIN32) || defined(_WIN64)

    DynamicLibrary load(String name) {
        DynamicLibrary dll

        dll.handle = LoadLibrary(String.c(name))
        if (dll.handle == NULL) {
            Log.warn("Couldn't load library")
            return invalidLibrary
        }

        dll.name = name
        dll.isValid = 1

        return dll
    }

    U0* get(DynamicLibrary dll, String functionName) {
        U0* func = (U0*)(GetProcAddress(dll.handle, String.c(functionName)))

        if (func == NULL) {
            Log.warn("Loading function %T", functionName)
        }

        return func
    }

    U0 unload(DynamicLibrary dll) {
        I32 r = FreeLibrary(dll.handle)

        dll.isValid = 0

        if (r == 0) {
            Log.warn("Failed freeing library")
        }
    }

#else

    DynamicLibrary load(String name) {
        DynamicLibrary dll

        dll.handle = dlopen(String.c(name), RTLD_LAZY)
        if (dll.handle == NULL) {
            Log.warn("Couldn't load library")
            return invalidLibrary
        }

        dll.name = name
        dll.isValid = 1

        return dll

    }

    U0* get(DynamicLibrary lib, String functionName) {
        U0* func = dlsym(lib.handle, String.c(functionName))

        if (func == NULL) {
            Log.warn("Loading function %T", functionName)
        }

        return func
    }

    U0 unload(DynamicLibrary dll) {
        if (dll.handle != NULL) {
            dlclose(dll.handle)
        }

        dll.isValid = 0
    }

#endif
}
