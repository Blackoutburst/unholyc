#include "uhcnet.uhh"
#include "uhcio.uhh"

namespace TcpClient {
#if defined(_WIN32) || defined(_WIN64)
    // Winsock is started once per process and left running until exit. Pairing a
    // WSACleanup with every destroy() tore Winsock down under sockets still in use
    // (a server-accepted client never called WSAStartup itself).
    static U8 _wsaInit() {
        static U8 ready = 0
        if (ready) return 1
        WSADATA wsaData
        if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0) return 0
        ready = 1
        return 1
    }

    TcpClient create(const String ip, I16 port) {
        TcpClient client

        struct sockaddr_in server_addr

        if (!_wsaInit()) {
            Log.warn("WSA startup failed")
            return client
        }

        client.sockfd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP)
        if (client.sockfd == INVALID_SOCKET) {
            Log.warn("Socket creation failed, error code: %d", WSAGetLastError())
            return client
        }

        memset(&server_addr, 0, sizeof(server_addr))
        server_addr.sin_family      = AF_INET
        server_addr.sin_port        = htons(port)

        if (inet_pton(AF_INET, String.c(ip), &server_addr.sin_addr) <= 0) {
            Log.warn("Invalid server address")
            destroy(client)
            return client
        }

        if (connect(client.sockfd, (struct sockaddr *)&server_addr, sizeof(server_addr)) == SOCKET_ERROR) {
            Log.warn("Connection failed")
            destroy(client)
            return client
        }

        return client
    }

    U0 destroy(TcpClient client) {
        if (client.sockfd == INVALID_SOCKET) return
        closesocket(client.sockfd)
        client.sockfd = INVALID_SOCKET
    }

    U8 write(TcpClient client, const I8* buffer, U32 size) {
        if (client.sockfd == INVALID_SOCKET) return 0
        send(client.sockfd, buffer, size, 0)

        return 1
    }

    U8 read(TcpClient client, I8* buffer, U32 size) {
        if (client.sockfd == INVALID_SOCKET) return 0

        I32 bytesRead = recv(client.sockfd, buffer, size, 0)
        if (bytesRead <= 0) return 0

        return 1
    }

    U8 readAll(TcpClient client, I8* buffer, U32 size) {
        if (client.sockfd == INVALID_SOCKET) return 0

        I32 totalBytesRead = 0
        while (totalBytesRead < size) {
            I32 bytesRead = recv(client.sockfd, buffer + totalBytesRead, size - totalBytesRead, 0)
            totalBytesRead += bytesRead
            if (bytesRead <= 0) return 0
        }

        return 1
    }
#else
    TcpClient create(const String ip, I16 port) {
        TcpClient client

        struct sockaddr_in server_addr

        client.sockfd = socket(AF_INET, SOCK_STREAM, 0)
        if (client.sockfd < 0) {
            Log.warn("Socket creation failed")
            return client
        }

        memset(&server_addr, 0, sizeof(server_addr))
        server_addr.sin_family = AF_INET
        server_addr.sin_port = htons(port)

        if (inet_pton(AF_INET, String.c(ip), &server_addr.sin_addr) <= 0) {
            Log.warn("Invalid server address")
            destroy(client)
            return client
        }

        if (connect(client.sockfd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
            Log.warn("Connection failed")
            destroy(client)
            return client
        }

        return client
    }

    U0 destroy(TcpClient client) {
        if (client.sockfd < 0) return
        close(client.sockfd)
        client.sockfd = -1
    }

    U8 write(TcpClient client, const I8* buffer, U32 size) {
        if (client.sockfd < 0) return 0
        
        send(client.sockfd, buffer, size, 0)

        return 1
    }

    U8 read(TcpClient client, I8* buffer, U32 size) {
        if (client.sockfd < 0) return 0

        I32 bytesRead = recv(client.sockfd, buffer, size, 0)
        if (bytesRead <= 0) return 0

        return 1
    }

    U8 readAll(TcpClient client, I8* buffer, U32 size) {
        if (client.sockfd < 0) return 0

        I32 totalBytesRead = 0
        while (totalBytesRead < size) {
            I32 bytesRead = recv(client.sockfd, buffer + totalBytesRead, size - totalBytesRead, 0)
            totalBytesRead += bytesRead
            if (bytesRead <= 0) return 0
        }

        return 1
    }
#endif
}
