#include "uhcio.uhh"

namespace File {
    File open(String filePath) {
        File file

        FILE* handle = fopen(String.c(filePath), "rb")
        if (!handle) {
            Log.warn("Couldn't find file")
            return file
        }

        file.handle = handle

        fseek(file.handle, 0, SEEK_END)
        I64 fileSize = ftell(file.handle)
        rewind(file.handle)

        file.size = fileSize
        
        return file
    }

    U0 close(File file) {
        fclose(file.handle)
    }

    String read(File file) {
        String empty

        if (!file.size) {
            Log.warn("File size error")
            fclose(file.handle)
            file.handle = NULL
            return empty
        }

        I8* buffer = (I8*)malloc(file.size + 1)
        if (!buffer) {
            Log.warn("File allocation failed")
            fclose(file.handle)
            file.handle = NULL
            return empty
        }

        I64 data = fread(buffer, 1, file.size, file.handle)
        if (data != file.size) {
            Log.warn("Reading file failed")
            free(buffer)
            fclose(file.handle)
            file.handle = NULL
            return empty
        }

        buffer[file.size] = 0x00
        fclose(file.handle)
        file.handle = NULL

        String result = String.from(buffer)
        free(buffer)
        return result
    }
}
