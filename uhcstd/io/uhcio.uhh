#pragma once

#include <stdio.h>
#include <stdlib.h>
#include "uhcstd.uhh"

/// Leveled logger with colored console output
namespace Log {
    /// Log level values for filtering output
    enum Level {
        UHC_LOG_TRACE,
        UHC_LOG_DEBUG,
        UHC_LOG_INFO,
        UHC_LOG_WARN,
        UHC_LOG_ERROR,
    }

    /// Log a message at TRACE level
    /// @param fmt printf-style format string
    /// @param ... Format arguments
    U0 trace(const I8* fmt, ...)
    /// Log a message at DEBUG level
    /// @param fmt printf-style format string
    /// @param ... Format arguments
    U0 debug(const I8* fmt, ...)
    /// Log a message at INFO level
    /// @param fmt printf-style format string
    /// @param ... Format arguments
    U0 info (const I8* fmt, ...)
    /// Log a message at WARN level
    /// @param fmt printf-style format string
    /// @param ... Format arguments
    U0 warn (const I8* fmt, ...)
    /// Log a message at ERROR level
    /// @param fmt printf-style format string
    /// @param ... Format arguments
    U0 error(const I8* fmt, ...)
    /// Log a raw message without a level prefix
    /// @param fmt printf-style format string
    /// @param ... Format arguments
    U0 msg  (const I8* fmt, ...)
}

/// Simple file reading utilities
namespace File {
    /// The file objects
    self {
        FILE* handle = NULL
        I64 size = 0
    }
    /// Open a file for reading
    /// @param filePath Path to the file
    /// @returns The file
    File open(const String filePath)
    /// Close an open file
    /// @param file The file
    U0 close(File file)
    /// Read the entire file contents into a String
    /// @param file The file
    /// @returns File contents, or empty string on error
    String read(File file)
    /// Read the entire file as raw bytes and close it — binary safe, unlike read
    /// @param file The file — its size field is the number of bytes returned
    /// @returns Heap buffer of file.size bytes that the caller must free(), or NULL on error
    U8* readBytes(File file)
}
